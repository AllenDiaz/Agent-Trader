# =============================================================================
# Trader Apps — environment configuration
#
# Copy this file to `.env` and fill in the values you need:
#     cp .env.example .env
#
# `.env` is git-ignored and MUST NOT be committed. Never put real secrets here.
# All variables are read at runtime via os.getenv(...) / python-dotenv.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM / model provider keys (backend/traders.py)
# -----------------------------------------------------------------------------
# Required by the OpenAI Agents SDK for the default OpenAI models.
OPENAI_API_KEY=

# Additional providers — only needed when USE_MANY_MODELS=true.
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
GROK_API_KEY=
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# External service keys
# -----------------------------------------------------------------------------
# Market data (backend/market.py)
MASSIVE_API_KEY=

# Web search MCP server (backend/mcp_servers.py)
TAVILY_API_KEY=

# Pushover notifications MCP server (backend/push_server.py)
PUSHOVER_TOKEN=
PUSHOVER_USER=

# -----------------------------------------------------------------------------
# Trading engine toggles (backend/trading_floor.py) — defaults shown
# -----------------------------------------------------------------------------
# How often the trading loop runs, in minutes.
RUN_EVERY_N_MINUTES=60

# Run the loop even when the market is closed ("true"/"false").
RUN_EVEN_WHEN_MARKET_IS_CLOSED=false

# Use multiple model providers instead of only the default ("true"/"false").
USE_MANY_MODELS=false
